---
import './volleyball-scorekeeper.css';
import type { VolleyballScoreKeeperUI } from './ui';

interface Props {
  ui?: Record<string, unknown>;
}
const { ui } = Astro.props;
const t = (ui ?? {}) as unknown as VolleyballScoreKeeperUI;
---

<div class="vb-root" data-vb-root
  data-txt-winner={t.winner}
  data-txt-match-point={t.matchPoint}
  data-txt-set-point={t.setPoint}
  data-txt-reset-confirm={t.resetConfirm}
  data-txt-fullscreen={t.fullscreen}
  data-txt-exit-fullscreen={t.exitFullscreen}
  data-txt-default-team-a={t.teamA}
  data-txt-default-team-b={t.teamB}
>
  <div class="vb-card-shell">
    
    <div class="vb-top-toolbar">
      <div class="vb-format-control">
        <button type="button" class="vb-btn-chip vb-active" data-vb-format="bestOf5">{t.matchModeBestOf5}</button>
        <button type="button" class="vb-btn-chip" data-vb-format="bestOf3">{t.matchModeBestOf3}</button>
        <button type="button" class="vb-btn-chip" data-vb-format="singleSet">{t.matchModeSingleSet}</button>
      </div>

      <div class="vb-toolbar-actions">
        <button type="button" class="vb-action-btn" data-vb-undo title="Undo">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
          <span>{t.undo}</span>
        </button>
        <button type="button" class="vb-action-btn" data-vb-switch title="Switch Sides">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>
          <span>{t.switchSides}</span>
        </button>
        <button type="button" class="vb-action-btn" data-vb-reset title="New Match">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span>{t.reset}</span>
        </button>
        <button type="button" class="vb-action-btn" data-vb-fullscreen title="Fullscreen">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          <span data-vb-fullscreen-txt>{t.fullscreen}</span>
        </button>
      </div>
    </div>

    <div class="vb-set-tracker-bar" data-vb-set-tracker>
      <div class="vb-set-pill vb-active-set" data-vb-set-pill="1">
        <span>Set 1</span>
        <strong data-vb-set-score="1">0 - 0</strong>
      </div>
      <div class="vb-set-pill" data-vb-set-pill="2">
        <span>Set 2</span>
        <strong data-vb-set-score="2">-</strong>
      </div>
      <div class="vb-set-pill" data-vb-set-pill="3">
        <span>Set 3</span>
        <strong data-vb-set-score="3">-</strong>
      </div>
      <div class="vb-set-pill" data-vb-set-pill="4">
        <span>Set 4</span>
        <strong data-vb-set-score="4">-</strong>
      </div>
      <div class="vb-set-pill" data-vb-set-pill="5">
        <span>Set 5</span>
        <strong data-vb-set-score="5">-</strong>
      </div>
    </div>

    <div class="vb-status-banner" data-vb-status-banner></div>

    <div class="vb-arena-grid">
      
      <div class="vb-team-card vb-team-a vb-is-serving" data-vb-team-card="teamA">
        <div class="vb-team-header">
          <input type="text" class="vb-team-name-input" data-vb-team-name="teamA" value={t.teamA} aria-label="Team A Name" />
          <div class="vb-serve-indicator" data-vb-serve-badge="teamA">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
            <span>{t.serving}</span>
          </div>
        </div>

        <div class="vb-score-box">
          <span class="vb-big-digit" data-vb-score="teamA" data-vb-add-point="teamA">0</span>
          <button type="button" class="vb-point-btn" data-vb-add-point="teamA" aria-label="Add point Team A">+</button>
        </div>

        <div class="vb-sets-won-row" data-vb-sets-won="teamA">
          <span class="vb-set-dot" data-vb-dot="1"></span>
          <span class="vb-set-dot" data-vb-dot="2"></span>
          <span class="vb-set-dot" data-vb-dot="3"></span>
        </div>

        <div class="vb-team-meta-row">
          <div class="vb-meta-group">
            <span>{t.timeoutsLeft}:</span>
            <button type="button" class="vb-micro-btn" data-vb-timeout-btn="teamA">
              <span data-vb-timeout-count="teamA">2</span> TO (30s)
            </button>
          </div>
          <div class="vb-meta-group">
            <span>{t.substitutions}:</span>
            <button type="button" class="vb-micro-btn" data-vb-sub-btn="teamA">
              <span data-vb-sub-count="teamA">0</span>/6 {t.substitutePlayer}
            </button>
          </div>
          <button type="button" class="vb-micro-btn" data-vb-rotate-btn="teamA" title="Rotate clockwise">
            {t.rotateCourt}
          </button>
        </div>
      </div>

      <div class="vb-team-card vb-team-b" data-vb-team-card="teamB">
        <div class="vb-team-header">
          <input type="text" class="vb-team-name-input" data-vb-team-name="teamB" value={t.teamB} aria-label="Team B Name" />
          <div class="vb-serve-indicator" data-vb-serve-badge="teamB">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
            <span>{t.serving}</span>
          </div>
        </div>

        <div class="vb-score-box">
          <span class="vb-big-digit" data-vb-score="teamB" data-vb-add-point="teamB">0</span>
          <button type="button" class="vb-point-btn" data-vb-add-point="teamB" aria-label="Add point Team B">+</button>
        </div>

        <div class="vb-sets-won-row" data-vb-sets-won="teamB">
          <span class="vb-set-dot" data-vb-dot="1"></span>
          <span class="vb-set-dot" data-vb-dot="2"></span>
          <span class="vb-set-dot" data-vb-dot="3"></span>
        </div>

        <div class="vb-team-meta-row">
          <div class="vb-meta-group">
            <span>{t.timeoutsLeft}:</span>
            <button type="button" class="vb-micro-btn" data-vb-timeout-btn="teamB">
              <span data-vb-timeout-count="teamB">2</span> TO (30s)
            </button>
          </div>
          <div class="vb-meta-group">
            <span>{t.substitutions}:</span>
            <button type="button" class="vb-micro-btn" data-vb-sub-btn="teamB">
              <span data-vb-sub-count="teamB">0</span>/6 {t.substitutePlayer}
            </button>
          </div>
          <button type="button" class="vb-micro-btn" data-vb-rotate-btn="teamB" title="Rotate clockwise">
            {t.rotateCourt}
          </button>
        </div>
      </div>

    </div>

    <div class="vb-tactical-section">
      <div class="vb-tactical-header">
        <span class="vb-tactical-title">{t.tacticalCourtTitle}</span>
        <span style="font-size: 0.72rem; color: #64748b;">P1: Server | P2-P4: Front Attack | P5-P6: Back Defense</span>
      </div>

      <div class="vb-court-canvas-wrap">
        <svg class="vb-court-svg" viewBox="0 0 600 300" preserveAspectRatio="xMidYMid meet">
          <rect x="8" y="8" width="584" height="284" fill="#0284c7" stroke="#ffffff" stroke-width="4" rx="6" />
          <line x1="300" y1="8" x2="300" y2="292" stroke="#f8fafc" stroke-width="4" stroke-dasharray="6 4" />
          <line x1="200" y1="8" x2="200" y2="292" stroke="#ffffff" stroke-width="2" stroke-dasharray="6 6" />
          <line x1="400" y1="8" x2="400" y2="292" stroke="#ffffff" stroke-width="2" stroke-dasharray="6 6" />
          <rect x="296" y="4" width="8" height="292" fill="#e2e8f0" rx="2" opacity="0.9" />
          
          <g data-vb-court-players-a></g>
          <g data-vb-court-players-b></g>
        </svg>
      </div>
    </div>

  </div>

  <div class="vb-timeout-modal" data-vb-timeout-modal>
    <div class="vb-timeout-card">
      <div class="vb-timeout-title" data-vb-timeout-title>{t.timeout}</div>
      <div class="vb-timeout-countdown" data-vb-timeout-sec>30</div>
      <button type="button" class="vb-btn-chip vb-active" style="padding: 0.5rem 1.5rem;" data-vb-close-timeout>
        {t.cancel}
      </button>
    </div>
  </div>

</div>

<script>
  import { VolleyballScorekeeperController } from './controller';

  function initApp() {
    const root = document.querySelector('[data-vb-root]') as HTMLElement | null;
    if (root) {
      new VolleyballScorekeeperController(root);
    }
  }

  document.addEventListener('DOMContentLoaded', initApp);
  initApp();
</script>
