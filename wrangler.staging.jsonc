{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "gamebob-utilities-sports-staging",
    "main": "src/worker.ts",
    "compatibility_date": "2026-07-22",
    "workers_dev": true,
    "preview_urls": true,
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "force-trailing-slash",
        "not_found_handling": "404-page"
    }
}
